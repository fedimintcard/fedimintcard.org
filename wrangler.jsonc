// fedimintcard.org: static assets from dist/, plus worker.js for byte ranges on /film/* (Safari and iOS play
// video only from 206 responses). The same setup as cashucard.org.
// Preview a version without publishing it: npx wrangler versions upload. Publish: npx wrangler deploy.
{
  "name": "fedimintcard-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "fedimintcard.org", "custom_domain": true },
    { "pattern": "www.fedimintcard.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/film/*"]
  },
  // Workers Caching: Cloudflare keeps the full film and serves byte-range slices of it from cache
  "cache": { "enabled": true },
  "observability": { "enabled": true }
}
